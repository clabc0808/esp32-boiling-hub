# Copy to config.env and fill in your values
# Bridge reads ~/hob-watch/config.env or environment variables

# Required: Gemini API key for boiling verdicts (empty = dry-run mode)
GEMINI_API_KEY=

# Gemini model (must support video input)
GEMINI_MODEL=gemini-2.0-flash

# HTTP server port
HOB_HTTP_PORT=8099

# Public hostname/IP of this bridge (used in clip_url sent to Home Assistant)
# This is what your phone will open when you tap a notification
HOB_BRIDGE_HOST=192.168.1.100

# MQTT broker for publishing verdicts
HOB_MQTT_HOST=127.0.0.1
HOB_MQTT_PORT=1883
HOB_MQTT_USER=
HOB_MQTT_PASS=
HOB_TOPIC=hob/boiling

# Path to ffmpeg binary
HOB_FFMPEG=/usr/bin/ffmpeg

# Send every Nth clip to Gemini (1 = every clip)
HOB_EVERY_N=1

# 1 = skip Gemini, publish dry-run verdicts (for testing)
HOB_DRY_RUN=0

# Number of processed clips to keep
HOB_KEEP_DONE=50
